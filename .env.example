# =====================================================
# ISHA 整合系統 — 環境變數設定範本
# 請複製此檔為 .env 並填入正確值
# cp .env.example .env
# =====================================================

# =====================================================
# KPI 系統資料庫（SQL Server）
# 測試主機沒有現成的 SQL Server，改用 docker-compose.prod.yml 內建的 kpi-db 容器，
# 兩個變數都要填：KPI_DB_SA_PASSWORD 給容器自己開機用，KPI_DB_CONNECTION 給 KPI API 連線用（host 用 kpi-db，密碼要跟 SA 密碼一致）。
# =====================================================
KPI_DB_SA_PASSWORD=Kpi@Str0ngP4ss!
KPI_DB_CONNECTION=Server=kpi-db;Database=isha_kpi;User ID=sa;Password=Kpi@Str0ngP4ss!;TrustServerCertificate=true

# =====================================================
# Forma 系統資料庫（PostgreSQL）
# 測試主機沒有現成的 PostgreSQL，改用 docker-compose.prod.yml 內建的 forma-db 容器，
# FORMA_DB_PASSWORD 給容器開機用，FORMA_DB_CONNECTION 給 Forma API 連線用（host 用 forma-db，密碼要一致）。
# =====================================================
FORMA_DB_PASSWORD=Forma@Str0ngP4ss!
FORMA_DB_CONNECTION=Host=forma-db;Port=5432;Database=forma;Username=postgres;Password=Forma@Str0ngP4ss!

# =====================================================
# JWT 統一設定（SSO 關鍵）
# KPI 系統與 Forma 系統必須使用相同的三個值，
# 讓使用者登入 KPI 後，token 在 Forma 中也能直接驗證。
#
# JWT_SECRET  ：至少 32 字元的隨機字串
# JWT_ISSUER  ：token 的發行者，通常填對外服務的 URL（含尾斜線）
# JWT_AUDIENCE：token 的接收對象，通常填前端應用的 URL（含尾斜線）
# =====================================================
JWT_SECRET=your-shared-secret-at-least-32-characters-long
JWT_ISSUER=https://your-domain.com/
JWT_AUDIENCE=https://your-domain.com/

# =====================================================
# KPI ↔ Forma 內部通訊密鑰
# KPI API 呼叫 Forma 內部端點時用來驗證身份，
# 兩邊必須使用相同的值，隨意填一個不易猜的字串即可。
# =====================================================
FORMA_INTERNAL_SECRET=change-me-to-a-random-string

# =====================================================
# LiteLLM API Key（KPI 聊天機器人 / 後台 AI 聊天測試頁面使用）
# 透過內部 LiteLLM proxy（https://llm.isafe.org.tw/）呼叫，
# 底層實際模型與 Base URL 設定於 appsettings.json 的 LiteLlm 區塊
# =====================================================
LITELLM_API_KEY=your-litellm-api-key

# =====================================================
# KPI AI 查詢助理（文件 RAG）— 向量資料庫（PostgreSQL + pgvector）
# 與 KPI 主庫（SQL Server）分開的獨立資料庫，由 docker-compose 內建的
# kpi-agent-db 服務提供。DB 名稱／帳號有預設值，密碼一定要填。
# 沒設定的話，AI 查詢助理的後台頁面（含 LiteLLM 連線設定）會 500。
# =====================================================
AGENT_VECTOR_DB_NAME=agent_vector
AGENT_VECTOR_DB_USER=agent
AGENT_VECTOR_DB_PASSWORD=change-me-to-a-random-string

# =====================================================
# 選填：本機測試用，從正式站 kpi-uploads volume 拉下來的督導報告 PDF，
# bind mount 進 kpi-api 的 wwwroot/Files。沒有這份資料就不用設，
# docker-compose.dev.yml 會退回掛一個空資料夾，不影響正常啟動。
# =====================================================
KPI_UPLOADS_HOST_DIR=./local-data/kpi-uploads

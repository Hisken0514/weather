# 複製成 .env 後填值,docker run --env-file .env 直接吃這份設定。

# 環境部環境資料開放平臺的 api_key——免費註冊會員取得,有效期一年,5000 次/日。
# 註冊/條款頁面:https://data.moenv.gov.tw/api-term
# 留空的話 moenv_get_dataset_records 這個工具會回傳清楚的錯誤訊息,但 mol_* 系列工具
# (勞動部,完全免金鑰)不受影響,照常可用。
MOENV_API_KEY=

# 通常不用改,除非要接測試環境或代理:
# MOL_BASE_URL=https://apiservice.mol.gov.tw/OdService
# MOENV_BASE_URL=https://data.moenv.gov.tw/api/v2
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# HTTP_TIMEOUT_SECONDS=15
